<Window x:Class="LanRoom.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LanRoom" Height="760" Width="1120" MinHeight="640" MinWidth="900"
        Background="#F3F5F9" Foreground="#1E293B" FontFamily="Segoe UI" FontSize="14"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,0,20">
            <TextBlock Text="LAN ROOM" FontSize="13" FontWeight="Bold" Foreground="#2563EB" />
            <TextBlock Text="和朋友连进同一个房间" FontSize="27" FontWeight="Bold" Margin="0,4,0,0" />
            <TextBlock Text="远程组网 · 房间聊天" Foreground="#64748B" Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="24">
            <Grid>
                <Grid x:Name="ConnectPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="连接服务器" FontSize="20" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="服务器地址" Foreground="#475569" Margin="0,0,0,7" />
                            <TextBox x:Name="ServerAddressBox" Text="http://127.0.0.1:8080" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="你的昵称" Foreground="#475569" Margin="0,0,0,7" />
                            <TextBox x:Name="DisplayNameBox" Text="玩家" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="创建房间" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="房间 ID 和密码可自定义，留空则自动生成。" Foreground="#64748B" Margin="0,5,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="房间名称" Foreground="#475569" Margin="0,0,0,5" />
                                <TextBox x:Name="RoomNameBox" Text="我的房间" ToolTip="房间名称" />
                                <TextBlock Text="房间 ID（留空自动生成）" Foreground="#475569" Margin="0,8,0,5" />
                                <TextBox x:Name="CreateRoomIdBox" ToolTip="4–32 位英文字母、数字、- 或 _" />
                                <TextBlock Text="房间密码（留空自动生成）" Foreground="#475569" Margin="0,8,0,5" />
                                <PasswordBox x:Name="CreatePasswordBox" Padding="11,9" BorderBrush="#CBD5E1" ToolTip="6–128 字符" />
                                <Button x:Name="CreateRoomButton" Content="创建并进入" Click="CreateRoom_Click" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="加入房间" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="输入朋友分享的房间 ID 和密码。" Foreground="#64748B" Margin="0,5,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="房间 ID" Foreground="#475569" Margin="0,0,0,5" />
                                <TextBox x:Name="RoomIdBox" ToolTip="房间 ID" />
                                <TextBlock Text="房间密码" Foreground="#475569" Margin="0,8,0,5" />
                                <PasswordBox x:Name="JoinPasswordBox" Padding="11,9" BorderBrush="#CBD5E1" ToolTip="房间密码" />
                                <Button x:Name="JoinRoomButton" Content="加入并进入" Click="JoinRoom_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="RoomPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock x:Name="RoomTitleText" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="RoomInfoText" Foreground="#64748B" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="语音（即将支持）" IsEnabled="False" Background="#CBD5E1" Foreground="#475569" Margin="0,0,8,0" />
                            <Button Content="屏幕共享（即将支持）" IsEnabled="False" Background="#CBD5E1" Foreground="#475569" Margin="0,0,8,0" />
                            <Button Content="离开房间" Click="LeaveRoom_Click" Background="#E2E8F0" Foreground="#334155" Margin="0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15">
                            <DockPanel>
                                <TextBlock x:Name="MemberCountText" DockPanel.Dock="Top" Text="房间成员" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ListBox x:Name="MembersList" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="文字聊天" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="发送" Click="SendChat_Click" Margin="10,0,0,0" Padding="18,9" />
                                    <TextBox x:Name="ChatInputBox" KeyDown="ChatInput_KeyDown" ToolTip="输入消息，按 Enter 发送" />
                                </DockPanel>
                                <ListBox x:Name="MessagesList" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="复制房间信息" Click="CopyInvite_Click" Background="#E2E8F0" Foreground="#334155" Margin="10,0,0,0" />
                        <TextBlock x:Name="InviteDetailsText" VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Grid.Row="3" Margin="0,4,0,0">
                        <Button x:Name="CopyVpnButton" DockPanel.Dock="Right" Content="复制 VPN 凭据" Click="CopyVpn_Click" IsEnabled="False" Background="#E2E8F0" Foreground="#334155" Margin="10,0,0,0" />
                        <TextBlock x:Name="VpnDetailsText" VerticalAlignment="Center" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="服务端默认地址为本机 127.0.0.1:8080。" Foreground="#64748B" Margin="2,14,2,0" TextWrapping="Wrap" />
    </Grid>
</Window>
